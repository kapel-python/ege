[Unit]
Description=EGE CORE standalone server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/root/ege
ExecStart=/usr/bin/python3 -u /root/ege/server/server.py

# The application handles SIGTERM and exits cleanly. systemd starts a fresh
# interpreter after crashes, while an explicit `systemctl restart` replaces it
# immediately after a code update.
# Keep the service available even when the application exits cleanly after a
# signal (server.py intentionally returns status 0 during graceful shutdown).
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

# Слушаем ТОЛЬКО loopback. Наружу торчит nginx (80/443) — и только он.
# На 0.0.0.0 сокет приложения доставался из интернета напрямую, мимо TLS,
# HSTS и лимитов nginx, а вместе с ним — заголовки X-Forwarded-*, которыми
# клиент сам выбирал себе IP-бакет (обход всех rate-limit'ов).
Environment=EGE_HOST=127.0.0.1
Environment=EGE_PORT=2026
Environment=EGE_QUIET=1
Environment=EGE_SUPERVISED=1
Environment=PYTHONUNBUFFERED=1
# Секреты живут вне репозитория: /etc/ege-2026.env (chmod 600).
# Обязательная переменная: EGE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$<iterations>$<salt>$<hash>
# Шаблон с примером (без значения): deploy/ege-2026.env.example
EnvironmentFile=-/etc/ege-2026.env

# Flood/OOM guardrails: the app itself rate-limits API (300/min per IP),
# caps concurrent requests (503 beyond 64) and reads sockets with a timeout —
# these unit limits are the outer ring, so one fat POST × N threads cannot
# take the host down. NOTE: no ProtectHome/ProtectSystem=strict here: the app
# lives in /root and writes its SQLite DB next to itself, read-only mounts
# would break it.
MemoryMax=512M
CPUQuota=100%
LimitNOFILE=4096
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=yes

# Всё, что приложение создаёт (БД, бэкапы, -wal/-shm), создаётся с правами
# только для владельца. Раньше бэкапы и SQLite лежали 0644 прямо в корне
# сайта: любой локальный процесс и всё, что когда-нибудь отдаст этот каталог,
# получали сессии всех учеников и хеши паролей из файла.
UMask=0077

StandardOutput=append:/var/log/ege-2026.log
StandardError=append:/var/log/ege-2026.log

[Install]
WantedBy=multi-user.target
