# Секреты окружения EGE CORE. Скопируй в /etc/ege-2026.env и выставь chmod 600.
# НЕ коммить заполненный файл — в репозитории хранится только этот шаблон.
#
# Хеш пароля админ-панели (PBKDF2-SHA256). Сгенерировать:
#   python3 -c "import hashlib,secrets; s=secrets.token_hex(16); \
#     print('pbkdf2_sha256$210000$%s$%s' % (s, hashlib.pbkdf2_hmac('sha256', input('пароль: ').encode(), bytes.fromhex(s), 210000).hex()))"
# ОБЯЗАТЕЛЬНАЯ переменная: без неё сервер отказывается стартовать.
# Встроенного fallback-хеша в коде нет — публичный репозиторий не должен
# поставлять рабочий админ-пароль (офлайн-подбор по опубликованному
# PBKDF2-хешу не ограничен троттлингом приложения).
EGE_ADMIN_PASSWORD_HASH=

# Публичный базовый URL сайта (для абсолютных ссылок в письмах/ответах).
# Если не задан, сервер выводит его из заголовков запроса.
# EGE_PUBLIC_URL=https://example.ru

# Сервер стоит за своим обратным прокси (nginx), который ПЕРЕЗАПИСЫВАЕТ
# X-Forwarded-For/Host/Proto. Включай только в этом случае: иначе любой
# клиент подменяет себе IP, Secure-флаги кук и внешние ссылки.
# EGE_TRUSTED_PROXY=1

# Принудительно считать соединение HTTPS (Secure-куки, HSTS), если прокси
# не выставляет X-Forwarded-Proto.
# EGE_ADMIN_COOKIE_SECURE=1

# Второй фактор входа в админку: подтверждение через Telegram-бота.
# Как только заданы ОБЕ переменные, верный пароль перестаёт открывать сессию
# сам: сервер создаёт заявку на 5 минут и шлёт владельцу сообщение с кодом,
# IP, временем и клиентом + кнопки «Подтвердить / Отклонить». Без обеих
# переменных вход работает как раньше — только по паролю.
# Бот заводится у @BotFather за пару минут (служебный, только для входа);
# EGE_TELEGRAM_ADMIN_CHAT_ID — числовой id владельца (узнать у @userinfobot),
# боту нужно написать первым (личный чат), иначе sendMessage не дойдёт.
# Решение из чужого чата игнорируется; молчание и просрочка — отказ.
# EGE_TELEGRAM_BOT_TOKEN=123456789:AA...
# EGE_TELEGRAM_ADMIN_CHAT_ID=123456789
# Время жизни заявки (сек, 30..3600, по умолчанию 300) — нужно только тестам.
# EGE_ADMIN_PENDING_TTL_SEC=300

# ИИ-проверка сочинений: два провайдера, приоритетный — CloseRouter,
# запасной — gptunnel. Отказ активного (баланс/таймаут/HTTP-ошибка) молча
# переключает запрос на запасного; раз в час фоновая проба возвращает
# приоритетный, когда он восстановился (EGE_AI_PROBE_INTERVAL_SEC).
# EGE_CLOSEROUTER_API_KEY=closerouter_...
# EGE_CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
# EGE_CLOSEROUTER_MODEL=anthropic/claude-sonnet-5
# AI_API_KEY=...            (gptunnel, запасной)
# AI_BASE_URL=https://gptunnel.ru/v1
# DEFAULT_MODEL=qwen3.8-flash

# Анти-лавиновая сетка ИИ (вСПЛЕСК, а не счёт за день): окно 60 с, потолки
# 60 запросов/мин на аккаунт и 300/мин на один адрес (последний равен общему
# /api/-барьеру). Живой человек с рабочим лимитом в это окно не попадает —
# поднимать нужно только под осознанный нагрузочный прогон.
# Лимит проверок в сутки — отдельная штука: EGE_AI_USAGE_MAX (5) и ходы
# ИИ EGE_AGENT_QUOTA_MAX (5), оба с тиком 8 ч (полный запас — за сутки); персональные
# потолки ставятся из карточки пользователя в админке.
# EGE_AI_RATE_MAX=60
# EGE_AI_NET_RATE_MAX=300
# EGE_AI_RATE_WINDOW_SEC=60

# Тариф Plus по умолчанию: 199 ₽/мес и 1590 ₽/год (−33% при оплате за год).
# Переопределяется без правки кода:
# EGE_PLUS_PRICE_MONTH_KOP=19900
# EGE_PLUS_PRICE_YEAR_KOP=159000

# Вход через Google (необязательно: без этих переменных кнопка входа через
# Google просто не показывается, а парольный вход работает как раньше).
# Client ID и secret — Google Cloud Console → «Учётные данные» → OAuth client ID
# (тип «Веб-приложение», consent screen «External»). Redirect URI должен
# совпадать с EGE_GOOGLE_REDIRECT_URI символ в символ.
# Секрет подписи state можно задать явно (EGE_OAUTH_SECRET) — иначе сервер
# создаёт его сам и хранит в app_config.
# EGE_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# EGE_GOOGLE_CLIENT_SECRET=GOCSPX-...
# EGE_GOOGLE_REDIRECT_URI=https://example.ru/api/auth/google/callback
# EGE_OAUTH_SECRET=
